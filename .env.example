# Copy to .env (never commit .env).  None of these are required for Wan2.2 TI2V-5B:
# the official repo is public and ungated, and no paid/cloud API is used anywhere.

# Which profile main.py uses when --config is not given
FILM_STUDIO_CONFIG=config/prod_rtx5080.toml

# Optional: HF token only raises download rate limits. Do NOT paste it into config files.
# HF_TOKEN=hf_xxx

# Optional: move the Hugging Face metadata cache to a bigger drive
# HF_HOME=D:/hf_cache

# Optional: pin the process to one GPU (index as shown by nvidia-smi)
# CUDA_VISIBLE_DEVICES=0

# Optional: reduces CUDA memory fragmentation on long runs
# PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
